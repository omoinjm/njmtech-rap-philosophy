# GitHub Personal Access Token with models:read scope (for Tape Deck AI chat)
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRE_HOURS=168

# Cloudflare D1 (production). Leave empty to use local SQLite at D1_LOCAL_PATH.
D1_DATABASE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_LOCAL_PATH=.data/chamber.db
